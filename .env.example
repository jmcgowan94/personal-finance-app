# Copy to .env and adjust. Everything has a sensible default for local use,
# so an empty .env (or none at all) also works.

# --- Database ---------------------------------------------------------------
# Default: SQLite file at ./data/app.db (nothing to install).
# docker compose overrides this with its bundled Postgres.
# On AWS: postgresql+psycopg://USER:PASSWORD@your-rds-endpoint:5432/finance
# DATABASE_URL=sqlite:///./data/app.db

# --- Auth -------------------------------------------------------------------
# local   = no login; everything belongs to a single local user
# cognito = requests must carry an Amazon Cognito token (for the hosted version)
AUTH_MODE=local
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=

# --- Uploaded statement files ------------------------------------------------
# local = ./data/uploads ; s3 = S3_BUCKET (install with `uv sync --extra aws`)
STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=./data/uploads
# S3_BUCKET=

# --- API --------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173
# MAX_UPLOAD_BYTES=10485760
